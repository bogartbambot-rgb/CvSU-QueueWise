# Environment variables (optional, set them in your terminal before running).
# Change both before running on a shared network/server.
QUEUEWISE_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
QUEUEWISE_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SESSION_SECRET
QUEUEWISE_HTTPS=0
# Optional: SQLite file path; Railway: mount a persistent volume to /data and use /data/queuewise.db
# QUEUEWISE_DB_PATH=/data/queuewise.db
# Railway requires public binding: HOST=0.0.0.0
# Railway HTTPS endpoint: QUEUEWISE_HTTPS=1

# Gmail API (recommended, HTTPS; no purchased domain required).
# Create a Gmail OAuth client and authorize gmail.send using the sender account.
QUEUEWISE_EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GMAIL_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=YOUR_OAUTH_REFRESH_TOKEN
GMAIL_SENDER_EMAIL=YOUR_AUTHORIZED_GMAIL_ADDRESS
QUEUEWISE_PUBLIC_URL=https://your-queuewise-domain.up.railway.app

# Optional alternative: Resend; requires a verified sender domain.
# QUEUEWISE_EMAIL_PROVIDER=resend
# RESEND_API_KEY=YOUR_RESEND_API_KEY
# QUEUEWISE_EMAIL_FROM=QueueWise <verify@your-verified-domain.example>
